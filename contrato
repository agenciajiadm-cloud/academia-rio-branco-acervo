css_style = """
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;600;800&display=swap');

@page {
size: A4;
margin: 15mm;
background-color: #F8F9FA; /* Fundo levemente cinza para destacar os blocos brancos */
}

body {
font-family: 'Inter', sans-serif;
color: #111827;
margin: 0;
padding: 0;
}

/* O "Papel" principal simulando a interface */
.document-wrapper {
background: #FFFFFF;
border: 2px solid #000000;
border-radius: 24px;
padding: 30px;
box-shadow: 8px 8px 0px #FF6700; /* Sombra dura estilo neobrutalismo/moderno */
}

/* Header Estilo App */
.header-ui {
background: #FF6700;
color: #000;
border: 2px solid #000;
border-radius: 16px;
padding: 20px;
margin-bottom: 25px;
display: flex;
}

.header-ui h1 {
margin: 0;
font-size: 28pt;
font-weight: 800;
text-transform: uppercase;
letter-spacing: -1px;
}

.badge {
background: #000;
color: #FFF;
padding: 5px 12px;
border-radius: 20px;
font-size: 9pt;
font-weight: 600;
display: inline-block;
margin-bottom: 10px;
}

/* Identificação das Partes (Os Avatares) */
.parties-grid {
display: table;
width: 100%;
margin-bottom: 25px;
border-collapse: separate;
border-spacing: 15px 0;
}

.party-card {
display: table-cell;
width: 50%;
background: #F3F4F6;
border: 2px solid #E5E7EB;
border-radius: 16px;
padding: 15px;
vertical-align: middle;
}

.avatar {
width: 40px;
height: 40px;
background: #FF6700;
border-radius: 50%;
display: inline-block;
vertical-align: middle;
margin-right: 10px;
border: 2px solid #000;
}

.party-info {
display: inline-block;
vertical-align: middle;
font-size: 10pt;
}

/* Blocos de Conteúdo */
.content-box {
border: 2px solid #000;
border-radius: 16px;
padding: 20px;
margin-bottom: 20px;
}

.content-box h2 {
font-size: 14pt;
font-weight: 800;
margin-top: 0;
margin-bottom: 15px;
display: inline-block;
border-bottom: 4px solid #FF6700;
}

/* Grid de Escopo */
.scope-grid {
display: table;
width: 100%;
}
.scope-item {
display: table-cell;
width: 50%;
padding-right: 10px;
}
.scope-title {
font-weight: 800;
font-size: 11pt;
margin-bottom: 5px;
}
.scope-desc {
font-size: 9.5pt;
color: #4B5563;
}

/* Bloco Financeiro e de Alerta */
.alert-box {
background: #111827;
color: #FFF;
border-radius: 16px;
padding: 20px;
margin-bottom: 20px;
}
.alert-box h2 { border-bottom-color: #FFF; }

.finance-box {
background: #FF6700;
border: 2px solid #000;
border-radius: 16px;
padding: 20px;
text-align: center;
margin-bottom: 25px;
}
.price-huge {
font-size: 32pt;
font-weight: 800;
margin: 10px 0;
}

/* Assinaturas */
.sig-container {
display: table;
width: 100%;
margin-top: 20px;
}
.sig-box {
display: table-cell;
width: 50%;
text-align: center;
}
.sig-line {
border-top: 2px solid #000;
width: 80%;
margin: 0 auto;
padding-top: 10px;
font-weight: 600;
font-size: 10pt;
}
"""

